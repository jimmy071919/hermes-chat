# Hermes Chat settings — copy to .env, edit, then: docker compose up -d --build

# Listen address. Use 127.0.0.1 for local only, or a private / tailnet IP to reach it from other devices.
HOST=127.0.0.1
PORT=9120
# Web login password.
APP_PASSWORD=change-me

# Absolute path of this project's data folder. It is mounted at the same path inside the
# container, so Hermes (on the host) and Hermes Chat see identical file paths.
DATA_PATH=/path/to/hermes-chat/data

# Your user / group id (run `id -u` and `id -g`), so files are shared with Hermes without permission problems.
UID=1000
GID=1000

# Optional: HTTPS. PEM certificate (leaf + intermediates) and key, absolute paths under your home
# folder. When both are set, Hermes Chat serves HTTPS on PORT and reloads renewed files by itself.
# TLS_CERT_FILE=/home/you/certs/hermes-chat.crt
# TLS_KEY_FILE=/home/you/certs/hermes-chat.key

# Optional: language Hermes should always answer in. Empty = same language as the user.
# REPLY_LANGUAGE=Traditional Chinese (繁體中文, Taiwan usage)

# Optional: tag + filter for sessions another OpenAI-compatible client (e.g. a voice assistant)
# creates through /v1/chat/completions. Empty = no tag.
# CHAT_COMPLETIONS_LABEL=Voice

# Optional overrides (defaults come from your Hermes .env):
# HERMES_HOME=/home/you/.hermes            # default: ~/.hermes
# HERMES_URL=http://127.0.0.1:8642         # default: API_SERVER_HOST:API_SERVER_PORT
# HERMES_API_KEY=...                       # default: API_SERVER_KEY
# MAX_UPLOAD_MB=200

# Optional: MCP / Skills management through the Hermes dashboard. Pick one:
# DASHBOARD_URL=http://127.0.0.1:9119
#  A) deployment token — start the dashboard with HERMES_DASHBOARD_SESSION_TOKEN=file:<path>
#     and point this at the same file (absolute path under your home folder):
# DASHBOARD_TOKEN_FILE=/home/you/.hermes/dashboard-session-token
#  B) dashboard login (dashboard.basic_auth):
# DASHBOARD_USER=...
# DASHBOARD_PASSWORD=...
