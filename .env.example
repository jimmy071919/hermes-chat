# Hermes Chat settings (copy to .env, then: docker compose up -d --build)
HOST=127.0.0.1
PORT=9120
# Absolute path of ./data; Hermes on the host must see the same path
DATA_PATH=/path/to/hermes-chat/data
APP_PASSWORD=change-me

# Optional overrides:
# HERMES_URL=http://127.0.0.1:8642          # default: API_SERVER_HOST:PORT from ~/.hermes/.env
# HERMES_API_KEY=...                        # default: API_SERVER_KEY from ~/.hermes/.env
# MAX_UPLOAD_MB=200

# MCP / Skills management via the Hermes dashboard (pick one):
# DASHBOARD_URL=http://127.0.0.1:9119
# DASHBOARD_TOKEN_FILE=/run/hermes-dashboard-token   # dashboard started with HERMES_DASHBOARD_SESSION_TOKEN
# DASHBOARD_USER=...
# DASHBOARD_PASSWORD=...
